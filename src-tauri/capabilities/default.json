{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, editor and recording dock windows",
  "windows": ["main", "editor", "dock", "recorder-overlay", "teleprompter", "settings", "device", "library", "donate"],
  "permissions": [
    "core:default",
    "opener:default",
    "process:allow-restart",
    "dialog:allow-open",
    "updater:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
