{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snap",
  "version": "3.0.0",
  "identifier": "com.ringale.snap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snap",
        "width": 1180,
        "height": 340,
        "minWidth": 960,
        "minHeight": 340,
        "visible": false,
        "backgroundColor": "#0b0d12",
        "decorations": false,
        "maximizable": false,
        "resizable": false
      },
      {
        "label": "dock",
        "url": "index.html?window=dock",
        "title": "Snap Recorder",
        "width": 460,
        "height": 74,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "recorder-overlay",
        "url": "index.html?window=recorder-overlay",
        "title": "Snap Overlay",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; connect-src ipc: http://ipc.localhost http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/snap.png",
      "icons/snap.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/snap.ico",
        "uninstallerIcon": "icons/snap.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDMxNjQ0Nzc3MTc3NDIxOEQKUldTTklYUVhkMGRrTVNVTVNFSFlpbm5XVDVJNzVBNTlielJDK1RnbnVuYzFmTndPVzFCOXFTKy8K",
      "endpoints": [
        "https://github.com/YumiNoona/Snap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
